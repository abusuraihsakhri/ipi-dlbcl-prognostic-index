{
  "openapi": "3.1.0",
  "info": {
    "title": "IPI DLBCL Prognostic Index API",
    "description": "Original IPI and R-IPI prognostic scoring, with token-protected deterministic supervisory mock tools. The running FastAPI service /openapi.json is authoritative.",
    "version": "3.1.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "JSON health and service metadata"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "JSON operational counters (not Prometheus text)"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Run demonstration supervisory audit (not clinical triage)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          },
          "401": {
            "description": "Invalid or missing supervisor token"
          },
          "503": {
            "description": "Supervisor API disabled without server-side token"
          }
        },
        "security": [
          {
            "SupervisorToken": []
          }
        ]
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return deterministic mock supervisory response (no external model)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          },
          "401": {
            "description": "Invalid or missing supervisor token"
          },
          "503": {
            "description": "Supervisor API disabled without server-side token"
          }
        },
        "security": [
          {
            "SupervisorToken": []
          }
        ]
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          },
          "401": {
            "description": "Invalid or missing supervisor token"
          },
          "503": {
            "description": "Supervisor API disabled without server-side token"
          }
        },
        "security": [
          {
            "SupervisorToken": []
          }
        ]
      }
    },
    "/": {
      "get": {
        "summary": "Serve browser calculator",
        "responses": {
          "200": {
            "description": "HTML calculator"
          }
        }
      }
    },
    "/api/ipi": {
      "post": {
        "summary": "Compute IPI and R-IPI",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IPIPatient"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Prognostic risk stratification"
          },
          "422": {
            "description": "Invalid clinical input"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SupervisorToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Token",
        "description": "Set SUPERVISOR_API_TOKEN on server; never embed this token in client code."
      }
    },
    "schemas": {
      "IPIPatient": {
        "type": "object",
        "required": [
          "age",
          "ldh_ratio",
          "ecog_ps",
          "stage",
          "extranodal_sites"
        ],
        "properties": {
          "age": {
            "type": "integer",
            "minimum": 0
          },
          "ldh_ratio": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ecog_ps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "stage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "extranodal_sites": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
